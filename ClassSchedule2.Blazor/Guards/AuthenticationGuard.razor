@using ClassSchedule2.Blazor.Components.Pages.Shared
@using ClassSchedule2.Blazor.Models.Enums
@using ClassSchedule2.Blazor.Providers
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject SchoolAuthenticationStateProvider SchoolAuthenticationProvider
@inject NavigationManager Navigation

@if(_loading)
{
    @* <LoadingSpinner Visible="@_loading" Message="Indlæser..." /> *@
    <p>Tester</p>
}
else if(_isAuthenticated && _isAuthorized)
{
    @ChildContent
}


@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public UserRoles? RequiredRole { get; set; }

    private bool _loading = true;
    private bool _isAuthenticated;
    private bool _isAuthorized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await SchoolAuthenticationProvider.InitializeAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        _isAuthenticated = user.Identity?.IsAuthenticated == true;

        _isAuthorized = _isAuthenticated && (!RequiredRole.HasValue || user.IsInRole(RequiredRole.Value.ToString()));

        _loading = false;

        if (!_isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!_isAuthorized)
        {
            Navigation.NavigateTo("/denied");
            return;
        }

        StateHasChanged();
    }
}