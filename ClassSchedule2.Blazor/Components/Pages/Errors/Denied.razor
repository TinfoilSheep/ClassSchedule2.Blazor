@page "/denied"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer
@layout EmptyLayout

<PageTitle>Ingen adgang - Skoleportalen</PageTitle>

<div class="relative flex min-h-screen flex-col items-center justify-center bg-slate-100 px-6 py-12 text-center text-slate-800 transition-colors duration-200 dark:bg-slate-950 dark:text-slate-100">

    <!-- Lås / Uautoriseret Ikon -->
    <div class="mb-6 inline-flex h-20 w-20 items-center justify-center rounded-2xl border border-amber-500/20 bg-amber-400/10 text-amber-600 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-10 w-10">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
    </div>

    <span class="text-xs font-bold tracking-widest text-amber-600 uppercase dark:text-amber-400">
        Fejl 403 / Adgang nægtet
    </span>

    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        Ingen adgang til siden
    </h1>

    <p class="mt-3 max-w-md text-sm text-slate-600 dark:text-slate-400">
        Du har ikke de nødvendige rettigheder eller en gyldig aktiv session til at se denne side. Venligst log ind med en konto, der har adgang.
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button @onclick="NavigateBack"
                type="button"
                class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 focus:ring-2 focus:ring-slate-400 focus:outline-none sm:w-auto dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
            <span>Tilbage til overblik</span>
        </button>
    </div>
</div>

@code {
    private async Task NavigateBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}