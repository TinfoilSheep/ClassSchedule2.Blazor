@page "/not-found"
@inject IJSRuntime JS
@rendermode InteractiveServer
@layout EmptyLayout

<div class="relative flex min-h-screen flex-col items-center justify-center bg-slate-100 px-6 py-12 text-center text-slate-800 transition-colors duration-200 dark:bg-slate-950 dark:text-slate-100">

    <!-- 404 Ikon -->
    <div class="mb-6 inline-flex h-20 w-20 items-center justify-center rounded-2xl border border-amber-500/20 bg-amber-400/10 text-amber-600 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-10 w-10">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
    </div>

    <!-- Overskrift og Fejlkode -->
    <span class="text-xs font-bold tracking-widest text-amber-600 uppercase dark:text-amber-400">
        Fejl 404
    </span>

    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        Siden blev ikke fundet
    </h1>

    <p class="mt-3 max-w-md text-sm text-slate-600 dark:text-slate-400">
        Siden du leder efter findes ikke, er blevet flyttet eller også har du fulgt et ugyldigt link.
    </p>

    <!-- Tilbage-knap -->
    <div class="mt-8">
        <button @onclick="NavigateToHome"
                type="button"
                class="flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-amber-400 px-6 py-3 text-sm font-semibold text-slate-950 shadow-md shadow-amber-500/10 transition-all hover:bg-amber-300 focus:ring-2 focus:ring-amber-500 focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Gå tilbage</span>
        </button>
    </div>
</div>

@code {
    private async Task NavigateToHome()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}