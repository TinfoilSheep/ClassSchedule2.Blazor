@using Microsoft.AspNetCore.Components;

<input type="time"
       value="@Value.ToString("HH:mm")"
       @onchange="OnChanged"
       class="@Class" />

@code {
    [Parameter]
    public TimeOnly Value { get; set; }

    [Parameter]
    public EventCallback<TimeOnly> ValueChanged { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private async Task OnChanged(ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), out var time))
        {
            Value = time;

            await ValueChanged.InvokeAsync(Value);
        }
    }
}
