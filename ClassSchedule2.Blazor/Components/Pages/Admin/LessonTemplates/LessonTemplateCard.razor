<!-- Header -->
<div class="flex items-start justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
    <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">
            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="1.8"
                 stroke="currentColor"
                 class="h-5 w-5">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6.75 3.75h10.5A2.25 2.25 0 0119.5 6v12a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 18V6a2.25 2.25 0 012.25-2.25z" />

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8.25 8.25h7.5M8.25 12h7.5M8.25 15.75h4.5" />
            </svg>
        </div>

        <div>
            <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                Lektionsplaner
            </h2>

            <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                Faste lektioner der kan bruges i skemaet
            </p>
        </div>
    </div>

    <button type="button"
            @onclick="OpenCreateModal"
            class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-amber-400 px-3 py-2 font-semibold text-[11px] text-slate-950 shadow-sm transition-colors hover:bg-amber-300">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="2"
             stroke="currentColor"
             class="h-4 w-4">

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4.5v15m7.5-7.5h-15" />
        </svg>

        Ny lektionsplan
    </button>
</div>

<!-- Content -->
<div class="p-3">

    @if (_isLoading)
    {
        <LoadingSpinner Message="Indlæser lektionsplaner..." Visible="_isLoading" />
    }
    else if (!_lessonTemplates.Any())
    {
        <div class="rounded-xl border border-dashed border-slate-200 px-4 py-8 text-center dark:border-slate-800">

            <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
                Der er endnu ikke oprettet nogen lektionsplaner.
            </p>

            <button type="button"
                    @onclick="OpenCreateModal"
                    class="mt-3 text-xs font-semibold text-amber-600 hover:text-amber-500 dark:text-amber-400">
                Opret den første lektionsplan →
            </button>
        </div>
    }
    else
    {
        <div class="max-h-80 overflow-y-auto pr-1">
            <div class="space-y-0.5">

                @foreach (var lessonTemplate in _lessonTemplates)
                {
                    <div class="group flex items-center justify-between rounded-xl px-3 py-2.5 transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">

                                <span class="shrink-0 rounded-lg bg-amber-400/10 px-2 py-1 font-semibold text-[11px] text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">
                                    @GetWeekDayName(lessonTemplate.WeekDay)
                                </span>

                                <span class="truncate text-sm font-medium text-slate-700 dark:text-slate-200">
                                    @lessonTemplate.HoldName
                                </span>
                            </div>

                            <div class="mt-1 flex flex-wrap items-center gap-x-2 text-[11px] text-slate-400 dark:text-slate-500">

                                <span>
                                    @lessonTemplate.PeriodName
                                </span>

                                <span>•</span>

                                <span>
                                    @lessonTemplate.ValidFrom.ToString("dd/MM/yyyy")
                                    –
                                    @lessonTemplate.ValidTo.ToString("dd/MM/yyyy")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(lessonTemplate.RoomName))
                                {
                                    <span>•</span>

                                    <span>
                                        @lessonTemplate.RoomName
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="ml-3 flex shrink-0 items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100">

                            <button type="button"
                                    @onclick="() => OpenEditModal(lessonTemplate)"
                                    class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-200 hover:text-slate-700 dark:hover:bg-slate-700 dark:hover:text-slate-200"
                                    title="Rediger">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="1.8"
                                     stroke="currentColor"
                                     class="h-4 w-4">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13l-3.135.895.895-3.135a4.5 4.5 0 011.13-1.897L16.862 4.487z" />

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M19.5 7.125L16.875 4.5" />
                                </svg>
                            </button>

                            <button type="button"
                                    @onclick="() => OpenDeleteModal(lessonTemplate)"
                                    class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-500/10 dark:hover:text-red-400"
                                    title="Slet">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="1.8"
                                     stroke="currentColor"
                                     class="h-4 w-4">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M6 7.5h12m-9 3v6m6-6v6M9.75 4.5h4.5l1.5 3H8.25l1.5-3zM7.5 7.5l.75 12h7.5l.75-12" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>


<!-- Footer -->
@if (!_isLoading && _lessonTemplates.Any())
{
    <div class="border-t border-slate-200 px-5 py-3 dark:border-slate-800">

        <span class="font-medium text-[11px] text-slate-400 dark:text-slate-500">
            @_lessonTemplates.Count @( _lessonTemplates.Count == 1 ? "lektionsplan" : "lektionsplaner")
        </span>
    </div>
}


<!-- Create modal -->
@if (_modalMode == CrudModalMode.Create)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/30 p-4 backdrop-blur-sm">

        <AddLessonTemplate OnSaved="HandleSaved"
                           OnCancel="CloseModals" />
    </div>
}
else if (_modalMode == CrudModalMode.Edit)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/30 p-4 backdrop-blur-sm">

        <EditLessonTemplate LessonTemplate="@_selectedLessonTemplate"
                            OnSaved="HandleSaved"
                            OnCancel="CloseModals" />

    </div>
}
else if (_modalMode == CrudModalMode.Delete)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/30 p-4 backdrop-blur-sm">
        <DeleteLessonTemplate LessonTemplate="@_selectedLessonTemplate"
                              OnDeleted="HandleSaved"
                              OnCancel="CloseModals" />
    </div>
}