@using Microsoft.AspNetCore.Components.Forms

<div class="flex max-h-[calc(100vh-2rem)] w-full max-w-lg flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900">

    <!-- Header -->
    <div class="flex shrink-0 items-start justify-between border-b border-slate-200 px-6 py-5 dark:border-slate-800">

        <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">
                Rediger lektionsplan
            </h2>

            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Rediger den valgte lektionsplan.
            </p>
        </div>

        <button type="button"
                @onclick="Cancel"
                disabled="@_isSubmitting"
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 disabled:cursor-not-allowed disabled:opacity-50 dark:hover:bg-slate-800 dark:hover:text-slate-200">

            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="2"
                 stroke="currentColor"
                 class="h-5 w-5">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12" />

            </svg>
        </button>
    </div>

    <!-- Form -->
    <EditForm Model="@_form"
              OnValidSubmit="HandleSubmitAsync"
              class="flex min-h-0 flex-1 flex-col">

        <DataAnnotationsValidator />

        <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-6 py-6">

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-400">
                    @_errorMessage
                </div>
            }

            @if (_isLoading)
            {
                <LoadingSpinner Visible="_isLoading"
                                Message="Indlæser data..."
                                FullScreen="false" />
            }
            else
            {
                <!-- Ugedag -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Ugedag
                    </label>

                    <InputSelect @bind-Value="_form.WeekDay"
                                 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">

                        <option value="0">
                            Vælg en ugedag...
                        </option>

                        <option value="1">Mandag</option>
                        <option value="2">Tirsdag</option>
                        <option value="3">Onsdag</option>
                        <option value="4">Torsdag</option>
                        <option value="5">Fredag</option>

                    </InputSelect>

                    <ValidationMessage For="@(() => _form.WeekDay)"
                                       class="mt-1 text-xs text-red-500" />
                </div>

                <!-- Gyldighed -->
                <div class="grid grid-cols-2 gap-4">

                    <!-- Fra -->
                    <div>
                        <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                            Gyldig fra
                        </label>

                        <InputDate @bind-Value="_form.ValidFrom"
                                   class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />

                        <ValidationMessage For="@(() => _form.ValidFrom)"
                                           class="mt-1 text-xs text-red-500" />
                    </div>

                    <!-- Til -->
                    <div>
                        <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                            Gyldig til
                        </label>

                        <InputDate @bind-Value="_form.ValidTo"
                                   class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />

                        <ValidationMessage For="@(() => _form.ValidTo)"
                                           class="mt-1 text-xs text-red-500" />
                    </div>

                </div>

                <!-- Hold -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Hold
                    </label>

                    <InputSelect @bind-Value="_form.HoldId"
                                 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">

                        <option value="">
                            Vælg et hold...
                        </option>

                        @foreach (var hold in _holds)
                        {
                            <option value="@hold.Id">
                                @hold.Name
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => _form.HoldId)"
                                       class="mt-1 text-xs text-red-500" />
                </div>

                <!-- Periode -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Periode
                    </label>

                    <InputSelect @bind-Value="_form.PeriodId"
                                 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">

                        <option value="">
                            Vælg en periode...
                        </option>

                        @foreach (var period in _periods)
                        {
                            <option value="@period.Id">
                                @period.Name
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => _form.PeriodId)"
                                       class="mt-1 text-xs text-red-500" />
                </div>

                <!-- Lokale -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Lokale
                        <span class="ml-1 font-normal text-slate-400">
                            (valgfrit)
                        </span>
                    </label>

                    <InputSelect @bind-Value="_form.RoomId"
                                 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">

                        <option value="">
                            Intet lokale
                        </option>

                        @foreach (var room in _rooms)
                        {
                            <option value="@room.Id">
                                @room.Name
                            </option>
                        }

                    </InputSelect>
                </div>
            }

        </div>

        <!-- Footer -->
        <div class="flex shrink-0 items-center justify-end gap-3 border-t border-slate-200 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-950/40">

            <button type="button"
                    @onclick="Cancel"
                    disabled="@_isSubmitting"
                    class="cursor-pointer rounded-xl px-4 py-2.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-50 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100">

                Annuller
            </button>

            <button type="submit"
                    disabled="@(_isSubmitting || _isLoading)"
                    class="inline-flex min-w-28 cursor-pointer items-center justify-center gap-2 rounded-xl bg-amber-400 px-4 py-2.5 text-xs font-semibold text-slate-950 shadow-sm transition-colors hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-60">

                @if (_isSubmitting)
                {
                    <LoadingSpinner Visible="_isSubmitting"
                                    Message="Gemmer..."
                                    FullScreen="false" />
                }
                else
                {
                    <span>Gem ændringer</span>
                }

            </button>

        </div>

    </EditForm>

</div>