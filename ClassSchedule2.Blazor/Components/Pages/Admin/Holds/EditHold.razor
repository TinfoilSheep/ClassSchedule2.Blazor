@using Microsoft.AspNetCore.Components.Forms

<div class="flex max-h-[calc(100vh-2rem)] w-full max-w-lg flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900">

    <!-- Header -->
    <div class="flex shrink-0 items-start justify-between border-b border-slate-200 px-6 py-5 dark:border-slate-800">

        <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">
                Rediger hold
            </h2>

            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Rediger holdets navn, fag, term, elever og lærere.
            </p>
        </div>

        <button type="button"
                @onclick="Cancel"
                disabled="@_isSubmitting"
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 disabled:cursor-not-allowed disabled:opacity-50 dark:hover:bg-slate-800 dark:hover:text-slate-200">

            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="2"
                 stroke="currentColor"
                 class="h-5 w-5">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12" />

            </svg>
        </button>
    </div>


    <!-- Form -->
    <EditForm Model="@_form"
              OnValidSubmit="HandleSubmitAsync"
              class="flex min-h-0 flex-1 flex-col">

        <DataAnnotationsValidator />

        <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-6 py-6">

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-400">
                    @_errorMessage
                </div>
            }

            <!-- Hold navn -->
            <div>
                <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                    Hold navn
                </label>

                <InputText @bind-Value="_form.Name"
                           autofocus
                           placeholder="F.eks. 1a. Matematik"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500" />

                <ValidationMessage For="@(() => _form.Name)"
                                   class="mt-1 text-xs text-red-500" />
            </div>

            <!-- Fag og Term -->
            <div class="grid grid-cols-2 gap-4">

                <!-- Fag -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Fag
                    </label>

                    <InputSelect @bind-Value="_form.SubjectId"
                                 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">

                        <option value="@Guid.Empty">
                            Vælg et fag...
                        </option>

                        @foreach (var subject in _subjects)
                        {
                            <option value="@subject.Id">
                                @subject.Name
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => _form.SubjectId)"
                                       class="mt-1 text-xs text-red-500" />
                </div>

                <!-- Term -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Term
                    </label>

                    <InputSelect @bind-Value="_form.TermId"
                                 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">

                        <option value="@Guid.Empty">
                            Vælg en term...
                        </option>

                        @foreach (var term in _terms)
                        {
                            <option value="@term.Id">
                                @term.Name
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => _form.TermId)"
                                       class="mt-1 text-xs text-red-500" />
                </div>
            </div>

            <!-- Elev grupper -->
            <div>

                <div class="mb-1.5 flex items-center gap-1.5">

                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Elevgrupper
                    </label>

                    <div class="group relative">

                        <button type="button"
                                class="flex h-4 w-4 cursor-help items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-300"
                                aria-label="Information om elevgruppe">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="2"
                                 stroke="currentColor"
                                 class="h-3.5 w-3.5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M12 16v-4m0-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </button>

                        <div class="pointer-events-none absolute bottom-full left-0 z-50 mb-2 w-64 rounded-lg bg-slate-900 px-3 py-2 text-xs leading-relaxed font-normal text-white opacity-0 shadow-lg transition-opacity group-hover:opacity-100 dark:bg-slate-700">

                            Brug en elevgruppe som en hurtig måde at tilføje mange elever på én gang.
                            Du kan stadig tilføje eller fjerne elever manuelt bagefter.

                        </div>
                    </div>
                </div>

                <div class="flex gap-2">

                    <InputSelect @bind-Value="_selectedStudentGroupId"
                                 class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">

                        <option value="@Guid.Empty">
                            Vælg en elevgruppe...
                        </option>

                        @foreach (var studentGroup in _studentGroups)
                        {
                            <option value="@studentGroup.Id">
                                @studentGroup.Name
                            </option>
                        }
                    </InputSelect>

                    <button type="button"
                            @onclick="AddSelectedStudentGroup"
                            disabled="@(_selectedStudentGroupId == Guid.Empty || _isLoading || _isSubmitting)"
                            class="inline-flex shrink-0 items-center justify-center rounded-xl bg-amber-400 px-4 py-2.5 text-xs font-semibold text-slate-950 shadow-sm transition-colors hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-50">

                        Tilføj elever
                    </button>
                </div>

                @if (_studentGroups.Count == 0)
                {
                    <p class="mt-1.5 text-xs text-slate-400">
                        Der er endnu ikke oprettet nogen elevgrupper.
                    </p>
                }
            </div>

            <!-- Elever -->
            <div class="grid grid-cols-2 gap-4">

                <!-- Tilgængelige elever -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Tilgængelige elever
                    </label>

                    <div class="relative mb-2">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-slate-400">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="m21 21-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>

                        <input type="text"
                               @bind="_studentSearchText"
                               @bind:event="oninput"
                               placeholder="Søg efter elev..."
                               class="w-full rounded-xl border border-slate-200 bg-white py-2 pr-9 pl-9 text-xs text-slate-900 shadow-sm transition outline-none placeholder:text-slate-400 focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />

                        @if (!string.IsNullOrWhiteSpace(_studentSearchText))
                        {
                            <button type="button"
                                    @onclick="ClearStudentSearch"
                                    class="absolute top-1/2 right-1.5 flex h-6 w-6 -translate-y-1/2 cursor-pointer items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="2"
                                     stroke="currentColor"
                                     class="h-3.5 w-3.5">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        }
                    </div>

                    <div class="h-64 overflow-y-auto rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">

                        @if (!FilteredStudents.Any())
                        {
                            <p class="p-3 text-sm text-slate-400">
                                @if (string.IsNullOrWhiteSpace(_studentSearchText))
                                {
                                    @:Ingen elever
                                }
                                else
                                {
                                    @:Ingen elever fundet
                                }
                            </p>
                        }

                        @foreach (var student in FilteredStudents)
                        {
                            <button type="button"
                                    @onclick="() => AddStudent(student)"
                                    class="flex w-full items-center justify-between px-3 py-2 text-left text-sm text-slate-900 transition hover:bg-amber-50 dark:text-slate-100 dark:hover:bg-slate-700">

                                <span>@student.Name</span>
                                <span class="text-amber-500">→</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Valgte elever -->
                <div>

                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Valgte elever
                    </label>

                    <div class="relative mb-2">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-slate-400">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="m21 21-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>

                        <input type="text"
                               @bind="_selectedStudentSearchText"
                               @bind:event="oninput"
                               placeholder="Søg efter valgt elev..."
                               class="w-full rounded-xl border border-slate-200 bg-white py-2 pr-9 pl-9 text-xs text-slate-900 shadow-sm transition outline-none placeholder:text-slate-400 focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />

                        @if (!string.IsNullOrWhiteSpace(_selectedStudentSearchText))
                        {
                            <button type="button"
                                    @onclick="ClearSelectedStudentSearch"
                                    class="absolute top-1/2 right-1.5 flex h-6 w-6 -translate-y-1/2 cursor-pointer items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="2"
                                     stroke="currentColor"
                                     class="h-3.5 w-3.5" />
                            </button>
                        }
                    </div>

                    <div class="h-64 overflow-y-auto rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">

                        @if (!FilteredSelectedStudents.Any())
                        {
                            <p class="p-3 text-sm text-slate-400">
                                @if (string.IsNullOrWhiteSpace(_selectedStudentSearchText))
                                {
                                    @:Ingen elever valgt
                                }
                                else
                                {
                                    @:Ingen elever fundet
                                }
                            </p>
                        }

                        @foreach (var student in FilteredSelectedStudents)
                        {
                            <button type="button"
                                    @onclick="() => RemoveStudent(student)"
                                    class="flex w-full items-center justify-between px-3 py-2 text-left text-sm text-slate-900 transition hover:bg-red-50 dark:text-slate-100 dark:hover:bg-slate-700">

                                <span class="text-red-400">←</span>
                                <span>@student.Name</span>

                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Lærere -->
            <div class="grid grid-cols-2 gap-4">

                <!-- Tilgængelige lærere -->
                <div>

                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Tilgængelige lærere
                    </label>

                    <div class="relative mb-2">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-slate-400">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="m21 21-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>

                        <input type="text"
                               @bind="_teacherSearchText"
                               @bind:event="oninput"
                               placeholder="Søg efter lærer..."
                               class="w-full rounded-xl border border-slate-200 bg-white py-2 pr-9 pl-9 text-xs text-slate-900 shadow-sm transition outline-none placeholder:text-slate-400 focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />

                        @if (!string.IsNullOrWhiteSpace(_teacherSearchText))
                        {
                            <button type="button"
                                    @onclick="ClearTeacherSearch"
                                    class="absolute top-1/2 right-1.5 flex h-6 w-6 -translate-y-1/2 cursor-pointer items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="2"
                                     stroke="currentColor"
                                     class="h-3.5 w-3.5">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M6 18L18 6M6 6l12 12" />

                                </svg>
                            </button>
                        }
                    </div>

                    <div class="h-64 overflow-y-auto rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">

                        @if (!FilteredTeachers.Any())
                        {
                            <p class="p-3 text-sm text-slate-400">
                                @if (string.IsNullOrWhiteSpace(_teacherSearchText))
                                {
                                    @:Ingen lærere
                                }
                                else
                                {
                                    @:Ingen lærere fundet
                                }
                            </p>
                        }

                        @foreach (var teacher in FilteredTeachers)
                        {
                            <button type="button"
                                    @onclick="() => AddTeacher(teacher)"
                                    class="flex w-full items-center justify-between px-3 py-2 text-left text-sm text-slate-900 transition hover:bg-amber-50 dark:text-slate-100 dark:hover:bg-slate-700">

                                <span>@teacher.Name</span>
                                <span class="text-amber-500">→</span>

                            </button>
                        }
                    </div>
                </div>

                <!-- Valgte lærere -->
                <div>

                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Valgte lærere
                    </label>

                    <div class="relative mb-2">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-slate-400">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="m21 21-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z" />

                        </svg>

                        <input type="text"
                               @bind="_selectedTeacherSearchText"
                               @bind:event="oninput"
                               placeholder="Søg efter valgt lærer..."
                               class="w-full rounded-xl border border-slate-200 bg-white py-2 pr-9 pl-9 text-xs text-slate-900 shadow-sm transition outline-none placeholder:text-slate-400 focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500" />

                        @if (!string.IsNullOrWhiteSpace(_selectedTeacherSearchText))
                        {
                            <button type="button"
                                    @onclick="ClearSelectedTeacherSearch"
                                    class="absolute top-1/2 right-1.5 flex h-6 w-6 -translate-y-1/2 cursor-pointer items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="2"
                                     stroke="currentColor"
                                     class="h-3.5 w-3.5">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M6 18L18 6M6 6l12 12" />

                                </svg>
                            </button>
                        }
                    </div>

                    <div class="h-64 overflow-y-auto rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">

                        @if (!FilteredSelectedTeachers.Any())
                        {
                            <p class="p-3 text-sm text-slate-400">
                                @if (string.IsNullOrWhiteSpace(_selectedTeacherSearchText))
                                {
                                    @:Ingen lærere valgt
                                }
                                else
                                {
                                    @:Ingen lærere fundet
                                }
                            </p>
                        }

                        @foreach (var teacher in FilteredSelectedTeachers)
                        {
                            <button type="button"
                                    @onclick="() => RemoveTeacher(teacher)"
                                    class="flex w-full items-center justify-between px-3 py-2 text-left text-sm text-slate-900 transition hover:bg-red-50 dark:text-slate-100 dark:hover:bg-slate-700">

                                <span class="text-red-400">←</span>
                                <span>@teacher.Name</span>

                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="flex shrink-0 items-center justify-end gap-3 border-t border-slate-200 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-950/40">

            <button type="button"
                    @onclick="Cancel"
                    disabled="@_isSubmitting"
                    class="cursor-pointer rounded-xl px-4 py-2.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-50 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100">

                Annuller
            </button>

            <button type="submit"
                    disabled="@_isSubmitting"
                    class="inline-flex min-w-28 cursor-pointer items-center justify-center gap-2 rounded-xl bg-amber-400 px-4 py-2.5 text-xs font-semibold text-slate-950 shadow-sm transition-colors hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-60">

                @if (_isSubmitting)
                {
                    <LoadingSpinner FullScreen="false"
                                    Message="Gemmer..."
                                    Visible="true" />
                }
                else
                {
                    <span>Gem ændringer</span>
                }
            </button>
        </div>
    </EditForm>
</div>