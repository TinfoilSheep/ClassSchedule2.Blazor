<!-- Elever og lærere overblik -->
<div class="mb-10">

    <div class="mb-4">
        <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
            Brugere
        </h2>

        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            Overblik over skolens brugere.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-2">

        <!-- Elever -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Elever
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_studentCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Registrerede elever
            </p>
        </div>

        <!-- Lærere -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Lærere
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_teacherCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Registrerede lærere
            </p>
        </div>
    </div>
</div>

<!-- Elevgrupper og hold -->
<div class="mb-10">

    <div class="mb-4">
        <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
            Elevgrupper og hold
        </h2>

        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            Overblik over de elevgrupper og hold, der indgår i skolens skemaplanlægning.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

        <!-- Elevgrupper -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Elevgrupper
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_studentGroupCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Oprettede elevgrupper
            </p>

        </div>

        <!-- Hold -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Hold
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_holdCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z" />

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M17.25 8.25a2.25 2.25 0 112.25-2.25 2.25 2.25 0 01-2.25 2.25z" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Oprettede hold
            </p>
        </div>
    </div>
</div>

<!-- Grundlag for skemagenerering -->
<div>

    <div class="mb-4">
        <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
            Grundlag for skemagenerering
        </h2>

        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            De grundlæggende oplysninger, der anvendes til at opbygge og generere skolens skema.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

        <!-- Terms -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Terminer
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_termCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M6.75 3v2.25M17.25 3v2.25M3.75 9h16.5M5.25 5.25h13.5A2.25 2.25 0 013 7.5v11.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V7.5a2.25 2.25 0 00-2.25-2.25H5.25z" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Oprettede terminer
            </p>
        </div>

        <!-- Periods -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Perioder
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_periodCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <circle cx="12" cy="12" r="8.25" />

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 7.5v4.75l3 1.75" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Oprettede perioder
            </p>
        </div>

        <!-- Rooms -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Lokaler
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_roomCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M3.75 21h16.5M5.25 21V5.25A2.25 2.25 0 017.5 3h9a2.25 2.25 0 012.25 2.25V21M8.25 7.5h1.5M8.25 11.25h1.5M14.25 7.5h1.5M14.25 11.25h1.5" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Registrerede lokaler
            </p>
        </div>

        <!-- Subjects -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Fag
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_subjectCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 6.75A6.75 6.75 0 005.25 4.5v12.75A6.75 6.75 0 0112 19.5m0-12.75A6.75 6.75 0 0118.75 4.5v12.75A6.75 6.75 0 0012 19.5m0-12.75v12.75" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Oprettede fag
            </p>
        </div>

        <!-- Non teaching days -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Ikke-undervisnings perioder
                    </p>

                    @if (_isLoading)
                    {
                        <div class="mt-2 h-8 w-16 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-800"></div>
                    }
                    else
                    {
                        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">
                            @_nonTeachingDayCount
                        </p>
                    }
                </div>

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:border-slate-800 dark:bg-slate-950 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <circle cx="12" cy="12" r="3.25" />

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 2.75v2M12 19.25v2M21.25 12h-2M4.75 12h-2M18.54 5.46l-1.42 1.42M6.88 17.12l-1.42 1.42M18.54 18.54l-1.42-1.42M6.88 6.88L5.46 5.46" />
                    </svg>
                </div>
            </div>

            <p class="mt-3 text-[11px] text-slate-400 dark:text-slate-500">
                Registrerede fridage/perioder
            </p>
        </div>
    </div>
</div>