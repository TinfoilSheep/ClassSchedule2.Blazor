@page "/admin/schedule-settings"
@using ClassSchedule2.Blazor.Components.Pages.Admin.Holds
@using ClassSchedule2.Blazor.Components.Pages.Admin.LessonGeneration
@using ClassSchedule2.Blazor.Components.Pages.Admin.LessonTemplates
@using ClassSchedule2.Blazor.Components.Pages.Admin.NonTeachingDays
@using ClassSchedule2.Blazor.Components.Pages.Admin.Periods
@using ClassSchedule2.Blazor.Components.Pages.Admin.Rooms
@using ClassSchedule2.Blazor.Components.Pages.Admin.StudentGroup
@using ClassSchedule2.Blazor.Components.Pages.Admin.Subjects
@using ClassSchedule2.Blazor.Components.Pages.Admin.Terms
@layout MainLayout

<AuthenticationGuard RequiredRoles="new[] {UserRoles.Admin}">
    <PageTitle>Skema administration - Skoleportalen</PageTitle>

    <main class="mx-auto w-full px-4 py-8 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="mb-10 text-center">
            <h1 class="text-xl font-extrabold tracking-tight text-slate-900 sm:text-2xl dark:text-slate-100">
                Skema administration
            </h1>

            <p class="mx-auto mt-2 max-w-2xl text-xs text-slate-500 dark:text-slate-400">
                Administrer de grundlæggende oplysninger, der bruges til at opbygge og planlægge skolens skema.
            </p>
        </div>


        <!-- Grundlæggende skemadata -->
        <div class="mb-6">
            <div class="mb-4">
                <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
                    Grundlæggende skemadata
                </h2>

                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    Disse oplysninger kan oprettes uafhængigt af hinanden og danner grundlaget for skemaplanlægningen.
                </p>
            </div>

            <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">

                <!-- Subjects -->
                <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <SubjectCard />
                </section>

                <!-- Rooms -->
                <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <RoomCard />
                </section>

                <!-- Terms -->
                <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <TermCard />
                </section>

                <!-- Periods -->
                <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <PeriodCard />
                </section>

                <!-- Non teaching days -->
                <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm xl:col-span-2 dark:border-slate-800 dark:bg-slate-900">
                    <NonTeachingDayCard />
                </section>

            </div>
        </div>


        <!-- Elevgrupper og hold -->
        <div class="mb-6">
            <div class="mb-4">
                <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
                    Elevgrupper og hold
                </h2>

                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    Elevgrupper og hold oprettes på baggrund af de elever, lærere og øvrige oplysninger, der allerede findes i systemet.
                </p>
            </div>

            <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">

                <!-- Student Groups -->
                <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <StudentGroupCard />
                </section>

                <!-- Holds -->
                <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <HoldCard />
                </section>

            </div>
        </div>

        <div>
            <div class="mb-4">
                <h2 class="text-base font-bold text-slate-900 dark:text-slate-100">
                    Lektionsplan og skemagenerering
                </h2>

                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    Lektionsplaner og skemaer oprettes på baggrund af de hold og øvrige oplysninger, der allerede findes i systemet.
                </p>
            </div>

            <div class="mb-4 grid grid-cols-1 gap-6 xl:grid-cols-2">

                <!-- LessonTemplate -->
                <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm xl:col-span-2 dark:border-slate-800 dark:bg-slate-900">
                    <LessonTemplateCard />
                </section>
            </div>

            <div class="flex justify-center">

                <!-- LessonGenerator -->
                <section class="w-full rounded-2xl border border-slate-200/80 bg-white shadow-sm xl:w-1/2 dark:border-slate-800 dark:bg-slate-900">
                    <LessonGeneratorCard />
                </section>

            </div>
        </div>

    </main>
</AuthenticationGuard>
