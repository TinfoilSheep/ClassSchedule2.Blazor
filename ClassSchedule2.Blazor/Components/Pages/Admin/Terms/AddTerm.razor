@using Microsoft.AspNetCore.Components.Forms

<div class="w-full max-w-lg overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900">
    <!-- Header -->
    <div class="flex items-start justify-between border-b border-slate-200 px-6 py-5 dark:border-slate-800">
        <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">
                Opret ny termin
            </h2>

            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Opret en termin, som kan bruges til skemaplanlægning.
            </p>
        </div>

        <button type="button"
                @onclick="Cancel"
                disabled="@_isSubmitting"
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 disabled:cursor-not-allowed disabled:opacity-50 dark:hover:bg-slate-800 dark:hover:text-slate-200">

            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="2"
                 stroke="currentColor"
                 class="h-5 w-5">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12" />

            </svg>
        </button>
    </div>

    <!-- Form -->
    <EditForm Model="@_form" OnValidSubmit="HandleSubmitAsync">

        <DataAnnotationsValidator />

        <div class="space-y-5 px-6 py-6">

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-400">
                    @_errorMessage
                </div>
            }

            <!-- Navn -->
            <div>
                <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                    Terminnavn
                </label>

                <InputText @bind-Value="_form.Name"
                           autofocus
                           placeholder="F.eks. Skoleåret 2026/2027"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500" />

                <ValidationMessage For="@(() => _form.Name)"
                                   class="mt-1 text-xs text-red-500" />
            </div>

            <!-- Datoer -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                <!-- Startdato -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Startdato
                    </label>

                    <InputDate @bind-Value="_form.StartDate"
                               class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />

                    <ValidationMessage For="@(() => _form.StartDate)"
                                       class="mt-1 text-xs text-red-500" />
                </div>

                <!-- Slutdato -->
                <div>
                    <label class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                        Slutdato
                    </label>

                    <InputDate @bind-Value="_form.EndDate"
                               class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />

                    <ValidationMessage For="@(() => _form.EndDate)"
                                       class="mt-1 text-xs text-red-500" />
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="flex items-center justify-end gap-3 border-t border-slate-200 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-950/40">
            <button type="button"
                    @onclick="Cancel"
                    disabled="@_isSubmitting"
                    class="cursor-pointer rounded-xl px-4 py-2.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 disabled:cursor-not-allowed disabled:opacity-50 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100">

                Annuller

            </button>

            <button type="submit"
                    disabled="@_isSubmitting"
                    class="inline-flex min-w-28 cursor-pointer items-center justify-center gap-2 rounded-xl bg-amber-400 px-4 py-2.5 text-xs font-semibold text-slate-950 shadow-sm transition-colors hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-60">

                @if (_isSubmitting)
                {
                    <LoadingSpinner Visible="_isSubmitting"
                                    Message="Opretter..."
                                    FullScreen="false" />
                }
                else
                {
                    <span>Opret termin</span>
                }
            </button>
        </div>
    </EditForm>
</div>