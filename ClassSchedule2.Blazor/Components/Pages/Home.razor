@page "/"
@layout EmptyLayout
@rendermode InteractiveServer

<div class="flex flex-1 flex-col justify-between">
    <!-- Topbar / Header -->
    <header class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-6">
        <div class="flex items-center space-x-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-amber-500/20 bg-amber-400 text-slate-950 shadow-md dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400 dark:shadow-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147L12 14.6l7.74-4.453M12 4.5l8.25 4.75v6.5L12 20.5l-8.25-4.75v-6.5L12 4.5z" />
                </svg>
            </div>
            <div>
                <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
                    Class Schedule
                </span>
                <p class="max-w-2xl text-base leading-relaxed text-slate-600 sm:text-sm dark:text-slate-400">
                    Your school day, organized
                </p>
            </div>
        </div>

        <div class="flex items-center space-x-3 sm:space-x-4">
            <button @onclick="NavigateToLogin" class="text-sm font-semibold text-slate-700 transition-colors hover:text-amber-600 dark:text-slate-300 dark:hover:text-amber-400">
                Log ind
            </button>

            <ThemeToggle />
        </div>
    </header>

    <!-- Hero Section -->
    <main class="mx-auto flex w-full max-w-5xl flex-grow flex-col items-center justify-center px-6 py-12 text-center">

        <!-- Badge -->
        <div class="mb-8 inline-flex items-center space-x-2 rounded-full border border-amber-500/20 bg-amber-400/10 px-3.5 py-1.5 text-xs font-semibold tracking-wider text-amber-600 uppercase dark:text-amber-400">
            <span>Skoleadministration & Skemaplanlægning</span>
        </div>

        <!-- Overskrift -->
        <h1 class="mb-6 text-4xl leading-tight font-extrabold tracking-tight text-slate-900 sm:text-6xl dark:text-slate-100">
            Det samlede overblik over <br class="hidden sm:inline" />
            <span class="text-amber-500 dark:text-amber-400">skolehverdagen</span>
        </h1>

        <p class="mb-10 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
            Platformen samler skemaer, fraværsregistrering og klassestyring for lærere, elever og administration i én samlet portal.
        </p>

        <!-- Knapper -->
        <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row">
            <button @onclick="NavigateToLogin"
                    class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-amber-400 px-8 py-3.5 text-sm font-semibold text-slate-950 shadow-md shadow-amber-500/10 transition-all hover:bg-amber-300 focus:ring-2 focus:ring-amber-500 focus:outline-none sm:w-auto">
                <span>Gå til Login</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </button>

            <button @onclick="NavigateToRegisterRequest"
                    class="w-full rounded-xl border border-slate-300 bg-white px-8 py-3.5 text-sm font-semibold text-slate-800 shadow-sm transition-all hover:bg-slate-50 sm:w-auto dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800/80">
                Anmod om oprettelse
            </button>
        </div>

        <!-- Feature Kort -->
        <div class="mt-16 grid w-full gap-6 text-left md:grid-cols-3">

            <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xl shadow-slate-200/50 transition-colors duration-200 dark:border-slate-800 dark:bg-slate-900 dark:shadow-none">
                <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:text-amber-400">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h3 class="mb-1 font-bold text-slate-900 dark:text-slate-100">Interaktive Skemaer</h3>
                <p class="text-xs text-slate-500 sm:text-sm dark:text-slate-400">Direkte opdateringer ved lokaleændringer eller vikardækning.</p>
            </div>

            <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xl shadow-slate-200/50 transition-colors duration-200 dark:border-slate-800 dark:bg-slate-900 dark:shadow-none">
                <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:text-amber-400">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h3 class="mb-1 font-bold text-slate-900 dark:text-slate-100">Hurtigt Fravær</h3>
                <p class="text-xs text-slate-500 sm:text-sm dark:text-slate-400">Effektiv registrering for lærere med få klik i hver lektion.</p>
            </div>

            <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xl shadow-slate-200/50 transition-colors duration-200 dark:border-slate-800 dark:bg-slate-900 dark:shadow-none">
                <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-amber-600 dark:text-amber-400">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                </div>
                <h3 class="mb-1 font-bold text-slate-900 dark:text-slate-100">Rollebaseret Adgang</h3>
                <p class="text-xs text-slate-500 sm:text-sm dark:text-slate-400">Tilpassede visninger alt efter om du er Elev, Lærer eller Admin.</p>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="mx-auto w-full max-w-7xl border-t border-slate-200 px-6 py-6 text-center text-xs text-slate-500 dark:border-slate-800/80 dark:text-slate-400">
        &copy; @DateTime.Now.Year Skoleportalen. Alle rettigheder forbeholdes.
    </footer>
</div>