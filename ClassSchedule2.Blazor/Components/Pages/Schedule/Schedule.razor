@page "/schedule"
@layout MainLayout

<AuthenticationGuard>
    <div class="flex h-full flex-col">

        <!-- Header -->
        <div class="mb-6 text-center">

            <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100">
                Skema
            </h1>

            <div class="mt-3 flex items-center justify-center gap-2">

                <!-- Previous week -->
                <button type="button"
                        @onclick="PreviousWeek"
                        class="cursor-pointer rounded-xl p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200"
                        title="Forrige uge">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="2"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 19l-7-7 7-7" />
                    </svg>
                </button>

                <!-- Week information -->
                <div class="min-w-[210px]">
                    <div class="text-lg font-semibold text-slate-700 dark:text-slate-300">
                        Uge @GetWeekNumber(_selectedWeek)
                    </div>

                    <div class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">
                        @GetWeekDateRange()
                    </div>
                </div>

                <!-- Next week -->
                <button type="button"
                        @onclick="NextWeek"
                        class="cursor-pointer rounded-xl p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200"
                        title="Næste uge">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="2"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>

            <!-- Today -->
            <button type="button"
                    @onclick="GoToCurrentWeek"
                    class="mt-2 cursor-pointer text-xs font-semibold text-amber-700 transition-colors hover:text-amber-500 dark:text-amber-400 dark:hover:text-amber-300">
                Gå til i dag
            </button>
        </div>

        @if (_isLoading)
        {
            <LoadingSpinner Visible="_isLoading" Message="Henter skema..." FullScreen="false" />
        }
        else
        {
            <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <div class="w-full min-w-[700px]">

                    <!-- Day headers -->
                    <div class="grid grid-cols-[70px_repeat(5,minmax(0,1fr))] border-b border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-950/40">

                        <!-- Empty grid cell -->
                        <div></div>

                        @foreach (var day in GetWeekDays())
                        {
                            <div class="border-l border-slate-200 px-3 py-4 text-center dark:border-slate-800">

                                <div class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                                    @day.ToString("dddd")
                                </div>

                                <div class="mt-1 text-lg font-bold text-slate-900 dark:text-slate-100">
                                    @day.Day
                                </div>

                            </div>
                        }
                    </div>

                    <!-- Schedule -->
                    <div class="grid grid-cols-[70px_repeat(5,minmax(0,1fr))]">

                        <!-- Time column -->
                        <div class="h-[320px]">
                            @for (var hour = 8; hour < 12; hour++)
                            {
                                <div class="h-20 border-b border-slate-100 px-2 pt-2 text-right text-xs font-medium text-slate-400 dark:border-slate-800/60">
                                    @($"{hour:00}:00")
                                </div>
                            }
                        </div>

                        <!-- Days -->
                        @foreach (var day in GetWeekDays())
                        {
                            <div class="relative h-[320px] border-l border-slate-200 dark:border-slate-800">

                                <!-- Time grid -->
                                @for (var hour = 8; hour < 12; hour++)
                                {
                                    <div class="h-20 border-b border-slate-100 dark:border-slate-800/60">
                                    </div>
                                }

                                <!-- Lessons -->
                                @foreach (var lesson in GetLessonsForDay(day))
                                {
                                    <div @onclick="() => OpenLessonModal(lesson)"
                                         class="absolute right-2 left-2 z-10 cursor-pointer rounded-xl border border-amber-400/20 bg-amber-400/10 p-3 shadow-sm transition-all hover:bg-amber-400/15 hover:shadow-md dark:border-sky-500/20 dark:bg-sky-500/10 dark:hover:bg-sky-500/15"
                                         style="top: @(GetLessonTop(lesson))px; height: @(GetLessonHeight(lesson))px;">

                                        <div class="flex items-start justify-between gap-2">

                                            <div class="min-w-0">
                                                <div class="truncate text-sm font-bold text-slate-900 dark:text-slate-100">
                                                    @lesson.SubjectName
                                                </div>

                                                <div class="mt-1 truncate text-xs text-slate-600 dark:text-slate-400">
                                                    @lesson.HoldName
                                                </div>
                                            </div>

                                            <div class="shrink-0 text-right font-medium text-[10px] text-slate-500 dark:text-slate-400">
                                                <div>@lesson.StartTime.ToString("HH:mm")</div>
                                                <div>@lesson.EndTime.ToString("HH:mm")</div>
                                            </div>

                                        </div>

                                        <div class="mt-2 truncate text-xs text-slate-500 dark:text-slate-400">
                                            @lesson.RoomName
                                        </div>

                                    </div>
                                }
                            </div>
                        }
                    </div>

                </div>
            </div>
        }
    </div>

    @if (_showLessonModal && _selectedLesson is not null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/30 p-4 backdrop-blur-sm">
            <LessonDetails Lesson="@_selectedLesson"
                           OnCancel="CloseLessonModal" />
        </div>
    }
</AuthenticationGuard>