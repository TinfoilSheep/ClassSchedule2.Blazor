<div class="w-full max-w-lg overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900">

    <!-- Header -->
    <div class="flex items-start justify-between border-b border-slate-200 px-6 py-5 dark:border-slate-800">

        <div class="flex min-w-0 items-center gap-3">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-amber-400/20 bg-amber-400/10 text-amber-600 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-400">

                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke-width="1.8"
                     stroke="currentColor"
                     class="h-5 w-5">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13l-2.5.75.75-2.5a4.5 4.5 0 011.13-1.897L16.862 4.487z" />

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 7.125L16.875 4.5M18 14.25V19.5A1.5 1.5 0 0116.5 21h-12A1.5 1.5 0 013 19.5v-12A1.5 1.5 0 014.5 6H9" />
                </svg>
            </div>

            <div class="min-w-0">

                <h2 class="truncate text-lg font-bold text-slate-900 dark:text-slate-100">
                    @(Lesson.Note is null ? "Tilføj note" : "Rediger note")
                </h2>

                <p class="mt-0.5 truncate text-xs text-slate-500 dark:text-slate-400">
                    @Lesson.SubjectName · @Lesson.HoldName
                </p>
            </div>
        </div>

        <button type="button"
                @onclick="OnCancel"
                class="ml-4 shrink-0 cursor-pointer rounded-lg p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200"
                aria-label="Luk">

            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="2"
                 stroke="currentColor"
                 class="h-5 w-5">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <!-- Content -->
    <div class="space-y-5 px-6 py-6">
        <div>
            <label class="mb-2 block text-sm font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
                Note
            </label>
            @if (Lesson.Note != null)
            {
                <p class="mb-2 text-xs text-slate-400 dark:text-slate-500">
                    Lad den være tom for at slette noten
                </p>                
            }

            <textarea @bind="_content"
                      @bind:event="oninput"
                      rows="6"
                      placeholder="Skriv en note til lektionen..."
                      class="w-full resize-none rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 transition outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500">
            </textarea>

            <div class="mt-2 text-right text-xs text-slate-400 dark:text-slate-500">
                @_content.Length tegn
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-end gap-3 border-t border-slate-200 px-6 py-4 dark:border-slate-800">

        <button type="button"
                @onclick="Cancel"
                class="cursor-pointer rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100">

            Annuller
        </button>

        <button type="button"
                @onclick="HandleSubmitAsync"
                disabled="@_isSubmitting"
                class="cursor-pointer rounded-xl bg-amber-400 px-5 py-2.5 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-50">

                @_submitButtonText
        </button>
    </div>
</div>