<div class="w-full max-w-lg overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900">
    <!-- Header -->
    <div class="flex items-start justify-between border-b border-slate-200 px-6 py-5 dark:border-slate-800">

        <div class="min-w-0">

            <div class="flex items-center gap-3">

                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-amber-400/20 bg-amber-400/10 text-amber-600 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 6.75v4.5l3 1.75m6-1a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>

                <div class="min-w-0">

                    <h2 class="truncate text-lg font-bold text-slate-900 dark:text-slate-100">
                        @Lesson.SubjectName
                    </h2>

                    <p class="mt-0.5 truncate text-xs text-slate-500 dark:text-slate-400">
                        @Lesson.HoldName
                    </p>

                </div>
            </div>
        </div>

        <!-- Close -->
        <button type="button"
                @onclick="OnCancel"
                class="ml-4 shrink-0 cursor-pointer rounded-lg p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">

            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="2"
                 stroke="currentColor"
                 class="h-5 w-5">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12" />

            </svg>
        </button>
    </div>
    <!-- Content -->
    <div class="space-y-5 px-6 py-6">

        @if (_isLoading)
        {
            <LoadingSpinner Visible="_isLoading" Message="Henter elever..." FullScreen="false" />
        }
        else
        {
            <!-- Date -->
            <div class="flex items-start gap-3">

                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-4 w-4">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M6.75 3v2.25M17.25 3v2.25M3 9.75h18M4.5 5.25h15a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 18.75v-12a1.5 1.5 0 011.5-1.5z" />
                    </svg>
                </div>

                <div>
                    <div class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Dato
                    </div>

                    <div class="mt-0.5 text-sm font-medium text-slate-900 dark:text-slate-100">
                        @Lesson.Date.ToString("dddd d. MMMM yyyy")
                    </div>
                </div>
            </div>

            <!-- Time -->
            <div class="flex items-start gap-3">

                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-4 w-4">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 6.75v4.5l3 1.75m6-1a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>

                <div>
                    <div class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Tidspunkt
                    </div>

                    <div class="mt-0.5 text-sm font-medium text-slate-900 dark:text-slate-100">
                        @Lesson.StartTime.ToString("HH:mm")
                        –
                        @Lesson.EndTime.ToString("HH:mm")
                    </div>
                </div>
            </div>

            <!-- Room -->
            <div class="flex items-start gap-3">

                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-4 w-4">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M3.75 21h16.5M4.5 21V5.25A2.25 2.25 0 016.75 3h10.5a2.25 2.25 0 012.25 2.25V21M8.25 7.5h2.25M8.25 11.25h2.25M13.5 7.5h2.25M13.5 11.25h2.25M9 21v-4.5h6V21" />
                    </svg>
                </div>

                <div>
                    <div class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Lokale
                    </div>

                    <div class="mt-0.5 text-sm font-medium text-slate-900 dark:text-slate-100">
                        @Lesson.RoomName
                    </div>
                </div>
            </div>

            <!-- Teachers -->
            <div class="flex items-start gap-3">

                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-4 w-4">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>

                </div>

                <div>
                    <div class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Lærer
                    </div>

                    <div class="mt-0.5 text-sm font-medium text-slate-900 dark:text-slate-100">
                        @string.Join(", ", Lesson.Teachers.Select(t => t.Name))
                    </div>
                </div>
            </div>

            <!-- Students -->
            <div class="flex items-start gap-3">

                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-4 w-4">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
                    </svg>

                </div>

                <div>
                    <div class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Elever
                    </div>

                    <div class="mt-0.5 text-sm font-medium text-slate-900 dark:text-slate-100">
                        @StudentsCount
                    </div>
                </div>

                <!-- View button -->
                <button type="button"
                        @onclick="() => OpenStudentListModal()"
                        class="ml-auto mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-200">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-4 w-4">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </button>
            </div>
        }

        <!-- Status -->
        <div class="border-t border-slate-100 pt-5 dark:border-slate-800">

            <div class="flex items-center justify-between">

                <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                    Status
                </span>

                <span class="inline-flex items-center rounded-lg border border-amber-400/20 bg-amber-400/10 px-2.5 py-1 font-semibold text-[11px] text-amber-700 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-400">
                    @Lesson.Status
                </span>
            </div>
        </div>

        <!-- Note -->
        <div class="border-t border-slate-100 pt-5 dark:border-slate-800">

            <div class="mb-3 flex items-center justify-between">

                <div class="flex items-center gap-2">

                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-4 w-4">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13l-2.5.75.75-2.5a4.5 4.5 0 011.13-1.897L16.862 4.487z" />

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M19.5 7.125L16.875 4.5M18 14.25V19.5A1.5 1.5 0 0116.5 21h-12A1.5 1.5 0 013 19.5v-12A1.5 1.5 0 014.5 6H9" />

                        </svg>
                    </div>

                    <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                        Note
                    </span>
                </div>

                <RoleGuard RequiredRoles="new[] { UserRoles.Teacher }">
                    <button type="button"
                            @onclick="OpenNoteModal"
                            class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-amber-700 transition hover:bg-amber-50 dark:text-amber-400 dark:hover:bg-amber-400/10">

                        @(Lesson.Note is null ? "Tilføj note" : "Rediger")
                    </button>
                </RoleGuard>
            </div>

            @if (Lesson.Note != null && !string.IsNullOrWhiteSpace(Lesson.Note.Content))
            {
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-relaxed text-slate-700 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300">

                    @Lesson.Note.Content
                </div>
            }
            else
            {
                <div class="rounded-xl border border-dashed border-slate-200 px-4 py-3 text-sm text-slate-400 dark:border-slate-800 dark:text-slate-500">

                    Ingen note tilføjet...
                </div>
            }
        </div>

        <!-- Absences -->
        <RoleGuard RequiredRoles="new[] { UserRoles.Teacher, UserRoles.Admin }">
            <div class="border-t border-slate-100 pt-5 dark:border-slate-800">
                <div class="mb-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-4 w-4">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M18 18.72a9.094 9.094 0 003.742-.479 3 3 0 00-4.742-2.724M18 18.72a9.094 9.094 0 01-3.742-.479 3 3 0 01-4.742 2.724M18 18.72a9.094 9.094 0 01-3.742-.479M15 11.25a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>

                        <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
                            Fravær
                        </span>
                    </div>

                    @* TODO Fiks lesson absences *@
                    @if (Lesson.AbsentStudents != null)
                    {
                        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                            @Lesson.AbsentStudents.Count / @StudentsCount
                        </span>
                    }
                </div>

                @if (Lesson.AbsentStudents != null && Lesson.AbsentStudents.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-slate-200 px-4 py-3 text-sm text-slate-400 dark:border-slate-800 dark:text-slate-500">
                        Ingen elever er registreret som fraværende.
                    </div>
                }
                else if(Lesson.AbsentStudents != null)
                {
                    <div class="mb-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 dark:border-red-500/20 dark:bg-red-500/10">

                        <div class="text-sm font-semibold text-red-700 dark:text-red-400">
                            @Lesson.AbsentStudents.Count @(Lesson.AbsentStudents.Count == 1 ? "elev" : "elever") registreret fraværende
                        </div>
                    </div>
                }

                <button type="button"
                        @onclick="OpenAbsenceModal"
                        class="mt-2 flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 hover:text-slate-900 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-4 w-4">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>

                    Registrer fravær
                </button>
            </div>
        </RoleGuard>
    </div>
</div>

@if (_modalMode == LessonInfoModalMode.Students)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/30 p-4 backdrop-blur-sm">
        <LessonStudents Students="@Students"
                        OnCancel="CloseModals" />
    </div>
}

@if (_modalMode == LessonInfoModalMode.Note)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/30 p-4 backdrop-blur-sm">
        <SetLessonNote Lesson="@Lesson"
                       OnSaved="HandleSaved"
                       OnCancel="CloseModals" />
    </div>
}

@if (_modalMode == LessonInfoModalMode.Absence)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/30 p-4 backdrop-blur-sm">
        <RegisterLessonAbsence Lesson="@Lesson"
                               Students="@Students"
                               OnSaved="HandleSaved"
                               OnCancel="CloseModals" />
    </div>
}