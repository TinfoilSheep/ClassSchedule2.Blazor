@page "/dashboard"
@using ClassSchedule2.Blazor.Components.Pages.Admin.AdminDashboard
@using ClassSchedule2.Blazor.Components.Pages.Student.StudentDashboard
@using ClassSchedule2.Blazor.Components.Pages.Teacher.TeacherDashboard
@layout MainLayout

<AuthenticationGuard>
    <PageTitle>Dashboards - Skoleportalen</PageTitle>

    <RoleGuard RequiredRoles="new[] {UserRoles.Admin}">
        <AdminDashboard />
    </RoleGuard>

    <RoleGuard RequiredRoles="new[] { UserRoles.Teacher }">
        <TeacherDashboard />
    </RoleGuard>

    <RoleGuard RequiredRoles="new[] { UserRoles.Student }">
        <StudentDashboard />
    </RoleGuard>
</AuthenticationGuard>