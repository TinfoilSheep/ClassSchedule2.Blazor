@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">

    <!-- Topbar -->
    <header class="sticky top-0 z-30 h-16 border-b border-slate-200/80 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
        <div class="flex h-full items-center justify-between px-4 sm:px-6 lg:px-8">

            <!-- Venstre side -->
            <div class="flex items-center gap-3">

                <button @onclick="ToggleMobileMenu"
                        type="button"
                        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 lg:hidden dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                        aria-label="Åbn menu">

                    @if (_mobileMenuOpen)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6 18L18 6M6 6l12 12" />

                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />

                        </svg>
                    }
                </button>

                <!-- Logo -->
                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400 text-slate-900 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="2"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4.26 10.147L12 14.6l7.74-4.453M12 4.5l8.25 4.75v6.5L12 20.5l-8.25-4.75v-6.5L12 4.5z" />

                    </svg>
                </div>

                <div class="hidden sm:block">
                    <div class="text-sm font-bold tracking-tight text-slate-900 dark:text-slate-100">
                        School Schedule
                    </div>

                    <div class="text-[11px] text-slate-500 dark:text-slate-400">
                        Skoleportalen
                    </div>
                </div>
            </div>

            <!-- Midten -->
            <div class="absolute left-1/2 hidden -translate-x-1/2 items-center sm:flex">

                <div class="text-sm font-bold tracking-tight text-slate-900 dark:text-slate-100">
                    @_institutionName
                </div>
            </div>

            <!-- Højre side -->
            <div class="flex items-center gap-3">

                <ThemeToggle />

                <!-- Bruger / Profil -->
                <NavLink href="/profile"
                         class="hidden items-center gap-3 rounded-xl border border-transparent px-3 py-1.5 shadow-sm transition-colors hover:border-slate-200 hover:bg-slate-50 sm:flex dark:hover:border-slate-700 dark:hover:bg-slate-800/70">

                    <!-- Profile icon -->
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-4 w-4">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M15.75 6.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a7.5 7.5 0 0115 0" />

                        </svg>
                    </div>

                    <!-- User information -->
                    <div class="text-right">
                        <div class="text-xs font-semibold text-slate-900 dark:text-slate-100">
                            @_userName
                        </div>

                        <div class="text-[11px] text-slate-500 dark:text-slate-400">
                            @_userRole
                        </div>
                    </div>

                    <!-- Initials -->
                    <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-xs font-bold text-amber-700 dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400">
                        @_userInitials
                    </div>

                    <!-- Arrow -->
                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-hover:translate-x-0.5 group-hover:text-slate-600 dark:text-slate-500 dark:group-hover:text-slate-300">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M9 5l7 7-7 7" />

                    </svg>
                </NavLink>
            </div>
        </div>
    </header>

    <!-- App layout -->
    <div class="flex h-[calc(100vh-4rem)] min-h-0">

        <!-- Desktop Sidebar -->
        <aside class="hidden h-full w-64 shrink-0 border-r border-slate-200/80 bg-white lg:flex dark:border-slate-800 dark:bg-slate-900">

            <div class="flex h-full min-h-0 w-full flex-col">

                <!-- Navigation -->
                <nav class="min-h-0 flex-1 space-y-1 overflow-y-auto p-4">

                    <!-- Dashboard -->
                    <NavLink href="/dashboard"
                             Match="NavLinkMatch.All"
                             class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                             ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M3.75 3.75h6.5v6.5h-6.5zM13.75 3.75h6.5v6.5h-6.5zM3.75 13.75h6.5v6.5h-6.5zM13.75 13.75h6.5v6.5h-6.5z" />

                        </svg>

                        <span>Dashboard</span>
                    </NavLink>

                    <!-- Schedule -->
                    @if (_userRole == "Student" || _userRole == "Teacher" || _userRole == "Admin")
                    {
                        <button type="button"
                                @onclick="NavigateToSchedule"
                                class="group flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />
                            </svg>

                            <span>Skema</span>
                        </button>
                    }

                    @if (_userRole == "Admin")
                    {
                        <NavLink href="/admin/users"
                                 class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />

                            </svg>

                            <span>Brugere</span>
                        </NavLink>

                        <NavLink href="/admin/schedule-settings"
                                 class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15.75 14.25a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm0 0l1.5 1.5m-6.75-6h.008v.008h-.008V9.75zm3 0h.008v.008H13.5V9.75zm3 0h.008v.008h-.008V9.75z" />

                            </svg>

                            <span>Skema administration</span>
                        </NavLink>
                    }
                </nav>

                <!-- Logout -->
                <div class="shrink-0 border-t border-slate-200/80 p-4 dark:border-slate-800">

                    <button @onclick="LogoutAsync"
                            type="button"
                            class="flex w-full cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600 dark:text-slate-400 dark:hover:bg-red-500/10 dark:hover:text-red-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 15l3-3m0 0l-3-3m3 3H3" />

                        </svg>

                        <span>Log ud</span>
                    </button>
                </div>
            </div>
        </aside>

        @if (_mobileMenuOpen)
        {
            <!-- Overlay -->
            <div @onclick="CloseMobileMenu"
                 class="fixed inset-0 z-40 bg-slate-950/30 backdrop-blur-sm lg:hidden">
            </div>

            <!-- Mobile menu -->
            <aside class="fixed inset-y-0 left-0 z-50 flex w-72 flex-col border-r border-slate-200 bg-white shadow-2xl lg:hidden dark:border-slate-800 dark:bg-slate-900">

                <!-- Header -->
                <div class="flex h-16 items-center justify-between border-b border-slate-200 px-4 dark:border-slate-800">

                    <div class="flex items-center gap-3">

                        <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400 text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="2"
                                 stroke="currentColor"
                                 class="h-5 w-5">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M4.26 10.147L12 14.6l7.74-4.453M12 4.5l8.25 4.75v6.5L12 20.5l-8.25-4.75v-6.5L12 4.5z" />
                            </svg>
                        </div>

                        <div>
                            <div class="text-sm font-bold text-slate-900 dark:text-slate-100">
                                School Schedule
                            </div>

                            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                                Skoleportalen
                            </div>
                        </div>
                    </div>

                    <button @onclick="CloseMobileMenu"
                            type="button"
                            class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                            aria-label="Luk menu">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             class="h-5 w-5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- User / Profile -->
                <div class="border-b border-slate-200 p-4 dark:border-slate-800">

                    <NavLink href="/profile"
                             @onclick="CloseMobileMenu"
                             class="group flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 transition-colors hover:border-amber-300 hover:bg-amber-50 dark:border-slate-700 dark:bg-slate-800/60 dark:hover:border-sky-500/50 dark:hover:bg-slate-800">

                        <!-- Profile icon -->
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-200 text-slate-500 dark:bg-slate-700 dark:text-slate-300">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15.75 6.75a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a7.5 7.5 0 0115 0" />

                            </svg>
                        </div>

                        <!-- User information -->
                        <div class="min-w-0 flex-1">

                            <div class="truncate text-xs font-semibold text-slate-900 dark:text-slate-100">
                                @_userName
                            </div>

                            <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
                                @_userRole
                            </div>
                        </div>

                        <!-- Arrow -->
                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-hover:translate-x-0.5 group-hover:text-slate-600 dark:text-slate-500 dark:group-hover:text-slate-300">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M9 5l7 7-7 7" />

                        </svg>

                    </NavLink>
                </div>

                <!-- Navigation -->
                <nav class="flex-1 space-y-1 overflow-y-auto p-4">

                    <div class="mb-2 px-3 font-bold tracking-wider text-[10px] text-slate-400 uppercase dark:text-slate-500">
                        @_institutionName
                    </div>

                    <NavLink href="/dashboard"
                             Match="NavLinkMatch.All"
                             @onclick="CloseMobileMenu"
                             class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                             ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-5 w-5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M3.75 3.75h6.5v6.5h-6.5zM13.75 3.75h6.5v6.5h-6.5zM3.75 13.75h6.5v6.5h-6.5zM13.75 13.75h6.5v6.5h-6.5z" />
                        </svg>

                        <span>Dashboard</span>
                    </NavLink>

                    <!-- Schedule -->
                    @if (_userRole == "Student" || _userRole == "Teacher" || _userRole == "Admin")
                    {
                        <button type="button"
                                @onclick="NavigateToSchedule"
                                class="group flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />
                            </svg>

                            <span>Skema</span>
                        </button>
                    }

                    @if(_userRole == "Student" || _userRole == "Teacher")
                    {
                        <NavLink href="/schedule"
                                 @onclick="CloseMobileMenu"
                                 class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />
                            </svg>

                            <span>Skema</span>
                        </NavLink>
                    }

                    @if (_userRole == "Admin")
                    {
                        <NavLink href="/admin/users"
                                 @onclick="CloseMobileMenu"
                                 class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15 19.128a9.38 9.38 0 002.625.372 9.38 9.38 0 002.625-.372M15 19.128v-3.5m0 3.5a9.38 9.38 0 01-2.625.372 9.38 9.38 0 01-2.625-.372M15 15.628v-3.5m0 0a3.75 3.75 0 10-7.5 0m7.5 0a3.75 3.75 0 10-7.5 0m0 0v3.5m0 0a9.38 9.38 0 01-2.625-.372m2.625.372a9.38 9.38 0 002.625.372" />

                            </svg>

                            <span>Brugere</span>
                        </NavLink>

                        <NavLink href="/admin/schedule-settings"
                                 @onclick="CloseMobileMenu"
                                 class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15.75 14.25a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm0 0l1.5 1.5m-6.75-6h.008v.008h-.008V9.75zm3 0h.008v.008H13.5V9.75zm3 0h.008v.008h-.008V9.75z" />

                            </svg>

                            <span>Skema administration</span>
                        </NavLink>
                    }
                </nav>

                <!-- Logout -->
                <div class="border-t border-slate-200 p-4 dark:border-slate-800">

                    <button @onclick="LogoutAsync"
                            type="button"
                            class="flex w-full cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600 dark:text-slate-400 dark:hover:bg-red-500/10 dark:hover:text-red-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-5 w-5">
                            <path stroke-linecap="round"
