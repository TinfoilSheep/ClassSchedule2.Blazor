@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">

    <!-- Topbar -->
    <header class="sticky top-0 z-30 h-16 border-b border-slate-200/80 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
        <div class="flex h-full items-center justify-between px-4 sm:px-6 lg:px-8">

            <!-- Venstre side -->
            <div class="flex items-center gap-3">

                <button @onclick="ToggleMobileMenu"
                        type="button"
                        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 lg:hidden dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                        aria-label="Åbn menu">

                    @if (_mobileMenuOpen)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6 18L18 6M6 6l12 12" />

                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />

                        </svg>
                    }
                </button>

                <!-- Logo -->
                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400 text-slate-900 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="2"
                         stroke="currentColor"
                         class="h-5 w-5">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4.26 10.147L12 14.6l7.74-4.453M12 4.5l8.25 4.75v6.5L12 20.5l-8.25-4.75v-6.5L12 4.5z" />

                    </svg>
                </div>

                <div class="hidden sm:block">
                    <div class="text-sm font-bold tracking-tight text-slate-900 dark:text-slate-100">
                        School Schedule
                    </div>

                    <div class="text-[11px] text-slate-500 dark:text-slate-400">
                        Skoleportalen
                    </div>
                </div>
            </div>

            <!-- Midten -->
            <div class="absolute left-1/2 hidden -translate-x-1/2 items-center sm:flex">

                <div class="text-sm font-bold tracking-tight text-slate-900 dark:text-slate-100">
                    @_institutionName
                </div>
            </div>

            <!-- Højre side -->
            <div class="flex items-center gap-3">

                <ThemeToggle />

                <!-- Bruger -->
                <div class="hidden items-center gap-3 border-l border-slate-200 pl-3 sm:flex dark:border-slate-800">
                    <div class="text-right">
                        <div class="text-xs font-semibold text-slate-900 dark:text-slate-100">
                            @_userName
                        </div>

                        <div class="text-[11px] text-slate-500 dark:text-slate-400">
                            @_userRole
                        </div>
                    </div>

                    <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400/10 text-xs font-bold text-amber-700 dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400">
                        @_userInitials
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- App layout -->
    <div class="flex h-[calc(100vh-4rem)] min-h-0">

        <!-- Desktop Sidebar -->
        <aside class="hidden h-full w-64 shrink-0 border-r border-slate-200/80 bg-white lg:flex dark:border-slate-800 dark:bg-slate-900">

            <div class="flex h-full min-h-0 w-full flex-col">

                <!-- Navigation -->
                <nav class="min-h-0 flex-1 space-y-1 overflow-y-auto p-4">

                    <!-- Dashboard -->
                    <NavLink href="/dashboard"
                             Match="NavLinkMatch.All"
                             class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                             ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M3.75 3.75h6.5v6.5h-6.5zM13.75 3.75h6.5v6.5h-6.5zM3.75 13.75h6.5v6.5h-6.5zM13.75 13.75h6.5v6.5h-6.5z" />

                        </svg>

                        <span>Dashboard</span>
                    </NavLink>

                    @* TODO: @if (_userRole == "Student" || _userRole == "Teacher") *@
                    @if (_userRole == "Student" || _userRole == "Teacher" || _userRole == "Admin")
                    {
                        <NavLink href="/schedule"
                                 class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />

                            </svg>

                            <span>Skema</span>
                        </NavLink>
                    }

                    @if (_userRole == "Admin")
                    {
                        <NavLink href="/admin/users"
                                 class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15 19.128a9.38 9.38 0 002.625.372 9.38 9.38 0 002.625-.372M15 19.128v-3.5m0 3.5a9.38 9.38 0 01-2.625.372 9.38 9.38 0 01-2.625-.372M15 15.628v-3.5m0 0a3.75 3.75 0 10-7.5 0m7.5 0a3.75 3.75 0 10-7.5 0m0 0v3.5m0 0a9.38 9.38 0 01-2.625-.372m2.625.372a9.38 9.38 0 002.625.372" />

                            </svg>

                            <span>Brugere</span>
                        </NavLink>

                        <NavLink href="/admin/schedule-settings"
                                 class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15.75 14.25a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm0 0l1.5 1.5m-6.75-6h.008v.008h-.008V9.75zm3 0h.008v.008H13.5V9.75zm3 0h.008v.008h-.008V9.75z" />

                            </svg>

                            <span>Skema administration</span>
                        </NavLink>
                    }
                </nav>

                <!-- Logout -->
                <div class="shrink-0 border-t border-slate-200/80 p-4 dark:border-slate-800">

                    <button @onclick="LogoutAsync"
                            type="button"
                            class="flex w-full cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600 dark:text-slate-400 dark:hover:bg-red-500/10 dark:hover:text-red-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-5 w-5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 15l3-3m0 0l-3-3m3 3H3" />

                        </svg>

                        <span>Log ud</span>
                    </button>
                </div>
            </div>
        </aside>

        @if (_mobileMenuOpen)
        {
            <!-- Overlay -->
            <div @onclick="CloseMobileMenu"
                 class="fixed inset-0 z-40 bg-slate-950/30 backdrop-blur-sm lg:hidden">
            </div>

            <!-- Mobile menu -->
            <aside class="fixed inset-y-0 left-0 z-50 flex w-72 flex-col border-r border-slate-200 bg-white shadow-2xl lg:hidden dark:border-slate-800 dark:bg-slate-900">

                <!-- Header -->
                <div class="flex h-16 items-center justify-between border-b border-slate-200 px-4 dark:border-slate-800">

                    <div class="flex items-center gap-3">

                        <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-amber-500/20 bg-amber-400 text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="2"
                                 stroke="currentColor"
                                 class="h-5 w-5">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M4.26 10.147L12 14.6l7.74-4.453M12 4.5l8.25 4.75v6.5L12 20.5l-8.25-4.75v-6.5L12 4.5z" />
                            </svg>
                        </div>

                        <div>
                            <div class="text-sm font-bold text-slate-900 dark:text-slate-100">
                                School Schedule
                            </div>

                            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                                Skoleportalen
                            </div>
                        </div>
                    </div>

                    <button @onclick="CloseMobileMenu"
                            type="button"
                            class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-slate-100"
                            aria-label="Luk menu">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             class="h-5 w-5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Navigation -->
                <nav class="flex-1 space-y-1 overflow-y-auto p-4">

                    <NavLink href="/dashboard"
                             Match="NavLinkMatch.All"
                             @onclick="CloseMobileMenu"
                             class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                             ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-5 w-5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M3.75 3.75h6.5v6.5h-6.5zM13.75 3.75h6.5v6.5h-6.5zM3.75 13.75h6.5v6.5h-6.5zM13.75 13.75h6.5v6.5h-6.5z" />
                        </svg>

                        <span>Dashboard</span>
                    </NavLink>

                    @if(_userRole == "Student" || _userRole == "Teacher")
                    {
                        <NavLink href="/schedule"
                                 @onclick="CloseMobileMenu"
                                 class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />
                            </svg>

                            <span>Skema</span>
                        </NavLink>
                    }

                    @if (_userRole == "Admin")
                    {
                        <NavLink href="/admin/users"
                                 @onclick="CloseMobileMenu"
                                 class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15 19.128a9.38 9.38 0 002.625.372 9.38 9.38 0 002.625-.372M15 19.128v-3.5m0 3.5a9.38 9.38 0 01-2.625.372 9.38 9.38 0 01-2.625-.372M15 15.628v-3.5m0 0a3.75 3.75 0 10-7.5 0m7.5 0a3.75 3.75 0 10-7.5 0m0 0v3.5m0 0a9.38 9.38 0 01-2.625-.372m2.625.372a9.38 9.38 0 002.625.372" />

                            </svg>

                            <span>Brugere</span>
                        </NavLink>

                        <NavLink href="/admin/schedule-settings"
                                 @onclick="CloseMobileMenu"
                                 class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100"
                                 ActiveClass="bg-amber-400/10 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M6.75 3.75v2.25m10.5-2.25v2.25M4.5 9.75h15M5.25 5.25h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z" />

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15.75 14.25a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm0 0l1.5 1.5m-6.75-6h.008v.008h-.008V9.75zm3 0h.008v.008H13.5V9.75zm3 0h.008v.008h-.008V9.75z" />

                            </svg>

                            <span>Skema administration</span>
                        </NavLink>
                    }
                </nav>

                <!-- Logout -->
                <div class="border-t border-slate-200 p-4 dark:border-slate-800">

                    <button @onclick="LogoutAsync"
                            type="button"
                            class="flex w-full cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600 dark:text-slate-400 dark:hover:bg-red-500/10 dark:hover:text-red-400">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke-width="1.8"
                             stroke="currentColor"
                             class="h-5 w-5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 15l3-3m0 0l-3-3m3 3H3" />
                        </svg>

                        <span>Log ud</span>
                    </button>
                </div>
            </aside>
        }

        <!-- Main content -->
        <main class="min-h-0 min-w-0 flex-1 overflow-y-auto"> 
            <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8"> 
                @Body 
            </div> 
        </main>

    </div>

</div>